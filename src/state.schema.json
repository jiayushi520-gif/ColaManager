{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"ColaManager state v1",
  "type":"object",
  "required":["schema_version","started_at","records","deadline_time","deadline_next_day"],
  "properties":{
    "schema_version":{"const":1},
    "started_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":"string","format":"date-time"},
    "deadline_time":{"type":"string","pattern":"^([01][0-9]|2[0-3]):[0-5][0-9]$"},
    "deadline_next_day":{"enum":[0,1,"0","1"]},
    "records":{"type":"object","additionalProperties":{
      "type":"object","required":["record_id","consumed_at","rinsed_at","brushed_at","brushing_deadline","week_start","status","violation_reason"],
      "properties":{
        "record_id":{"type":"string","minLength":1},
        "consumed_at":{"type":"string","format":"date-time"},
        "rinsed_at":{"type":"string"},
        "brushed_at":{"type":"string"},
        "brushing_deadline":{"type":"string","format":"date-time"},
        "week_start":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
        "status":{"enum":["pending","compliant","late","missed"]},
        "violation_reason":{"type":"string"}
      }
    }}
  }
}
