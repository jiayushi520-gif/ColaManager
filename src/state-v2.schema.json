{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ColaManager v2 snapshot",
  "type": "object",
  "required": ["schema_version", "app_version", "revision", "created_at", "started_at", "updated_at", "records", "deadline_time", "deadline_next_day", "reminder_time"],
  "properties": {
    "schema_version": {"const": 2},
    "app_version": {"const": "2.0.0"},
    "revision": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "deadline_time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
    "reminder_time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
    "deadline_next_day": {"enum": [0, 1, "0", "1"]},
    "records": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["record_id", "consumed_at", "brushing_deadline", "rinsed_at", "brushed_at", "week_start", "status", "violation_reason"],
        "properties": {
          "record_id": {"type": "string", "minLength": 1},
          "consumed_at": {"type": "string", "format": "date-time"},
          "brushing_deadline": {"type": "string", "format": "date-time"},
          "rinsed_at": {"type": "string"},
          "brushed_at": {"type": "string"},
          "week_start": {"type": "string"},
          "status": {"enum": ["pending", "compliant", "late", "missed"]},
          "violation_reason": {"type": "string"}
        }
      }
    }
  }
}
